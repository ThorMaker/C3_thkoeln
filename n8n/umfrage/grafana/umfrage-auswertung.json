    {
      "id": 5,
      "title": "$frage",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "umfragen"
      },
      "description": "Verteilung der gewaehlten Frage.",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 13,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "umfragen"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE\n         WHEN \"${frage}\"::text = 'true'  THEN 'Ja'\n         WHEN \"${frage}\"::text = 'false' THEN 'Nein'\n         WHEN \"${frage}\" IS NULL OR \"${frage}\"::text = '' THEN 'ohne Angabe'\n         ELSE \"${frage}\"::text END AS \"Antwort\",\n       count(*) AS \"Anzahl\"\nFROM \"p6jz2gyuwlapqqe\".\"${umfrage}\" WHERE \"__nc_deleted\" IS NOT TRUE\nGROUP BY 1\nORDER BY\n  -- Zahlen (Bewertungen) nach ihrem Wert, alles andere nach Haeufigkeit\n  CASE WHEN max(\"${frage}\"::text) ~ '^[0-9]+$' THEN lpad(max(\"${frage}\"::text), 6, '0') END DESC NULLS LAST,\n  count(*) DESC\nLIMIT 25",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#C81E0F"
          },
          "unit": "short",
          "custom": {
            "axisGridShow": false,
            "axisBorderShow": false,
            "axisLabel": "",
            "lineWidth": 0,
            "fillOpacity": 88,
            "gradientMode": "none",
            "axisPlacement": "auto",
            "hideFrom": {
