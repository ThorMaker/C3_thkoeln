  "templating": {
    "list": [
      {
        "name": "umfrage",
        "label": "Umfrage",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "umfragen"
        },
        "refresh": 1,
        "sort": 0,
        "includeAll": false,
        "multi": false,
        "definition": "",
        "query": "SELECT m.title AS \"__text\", m.table_name AS \"__value\"\nFROM public.nc_models_v2 m\nWHERE m.base_id = 'p6jz2gyuwlapqqe'\nAND m.table_name NOT IN ('umfragen') AND m.table_name NOT LIKE 'zugelassen%'\nAND coalesce(m.deleted,false) = false ORDER BY m.created_at DESC"
      },
      {
        "name": "frage",
        "label": "Frage",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "umfragen"
        },
        "refresh": 1,
        "sort": 0,
        "includeAll": false,
        "multi": false,
        "definition": "",
        "query": "SELECT c.title AS \"__text\", c.column_name AS \"__value\"\nFROM public.nc_columns_v2 c\nJOIN public.nc_models_v2 m ON m.id = c.fk_model_id\nWHERE m.base_id = 'p6jz2gyuwlapqqe' AND m.table_name = '${umfrage}' AND coalesce(c.system,false) = false\nAND c.uidt IN ('SingleSelect','MultiSelect','Rating','Checkbox','Number','LongText','SingleLineText') ORDER BY c.\"order\""
      },
      {
        "name": "kennung",
        "label": "Kennung",
        "type": "query",
        "hide": 2,
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "umfragen"
        },
        "definition": "kennung zur gewählten Umfrage",
        "query": "SELECT u.kennung AS \"__text\", u.kennung AS \"__value\" FROM \"p6jz2gyuwlapqqe\".\"umfragen\" u JOIN public.nc_models_v2 m ON m.id = u.antwort_tabelle WHERE m.table_name = '${umfrage}' AND u.\"__nc_deleted\" IS NOT TRUE LIMIT 1",
        "refresh": 2,
        "regex": "",
        "sort": 0,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": []
      }
    ]
  },
