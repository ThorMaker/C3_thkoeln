    {
      "id": 4,
      "title": "Eingang je Minute",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "umfragen"
      },
      "description": "Im Hoersaal sieht man hier die Welle nach dem Scannen.",
      "transparent": true,
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
