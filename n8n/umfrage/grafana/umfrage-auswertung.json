    {
      "id": 2,
      "title": "Beteiligung",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "umfragen"
      },
      "description": "Wie viele der Zugelassenen geantwortet haben.",
      "transparent": true,
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "umfragen"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN count(*)=0 THEN NULL\n       ELSE round(100.0*count(*) FILTER (WHERE abgestimmt)/count(*),0) END AS \"Beteiligung\"\nFROM \"p6jz2gyuwlapqqe\".\"zugelassen_${umfrage}\" WHERE \"__nc_deleted\" IS NOT TRUE",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
